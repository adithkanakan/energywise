# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data & models (never commit raw/processed data or trained artifacts by default)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# MLflow (if used)
mlruns/

# Logs and derived data files
*.log
data/*.parquet
